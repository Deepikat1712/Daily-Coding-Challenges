class Solution {
    public int[] plusOne(int[] a) {
        int a1[] = new int[a.length+1];
        for(int i=a.length-1 ; i>=0 ; i--){
            if(a[i]<9){
                a[i]++;
                return a;
            }
            a1[0]=1;
            return a1;
        }
        return a1;
    }

}
